# Copy to .env and fill in values. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
SCENARIO=simple

# --- Cloudsmith (docker build + local pip) ---
# Private eval token. Do not republish wheels or commit the token.
# Paste the entitlement into PIP_INDEX_URL (Compose does not expand nested .env tokens).
CLOUDSMITH_TOKEN=
PIP_INDEX_URL=https://airaa-airaa:<CLOUDSMITH_TOKEN>@dl.cloudsmith.io/basic/xtap/xtap/python/simple/
PIP_EXTRA_INDEX_URL=https://pypi.org/simple

# --- Shared ACT (one tenant) ---
XTAP_URL=https://act.xtap.dev
XTAP_TENANT_ID=
XTAP_KEY_PASSPHRASE=
# XTAP_AGENT_STATE_DIR=           # default ~/.xtap/fabric; Compose mounts /var/lib/xtap
# XTAP_FABRIC_ISSUER=             # receive-side JWT issuer; defaults to XTAP_URL
# XTAP_FABRIC_JWKS_URL=           # defaults to {issuer}/.well-known/jwks.json

# --- Consent ---
# Mode A: coordinator prints an authorize URL (open_browser=False). After Approve,
# ACT redirects to http://127.0.0.1:9876/callback (published from Compose).
XTAP_CALLBACK_HOST=127.0.0.1
XTAP_CALLBACK_BIND_HOST=0.0.0.0
XTAP_CALLBACK_PORT=9876

# --- Per-agent software identities (one pair per enrolled process) ---
SRE_COORDINATOR_SOFTWARE_ID=
SRE_COORDINATOR_SOFTWARE_SECRET=
GITHUB_AGENT_SOFTWARE_ID=
GITHUB_AGENT_SOFTWARE_SECRET=
DATADOG_AGENT_SOFTWARE_ID=
DATADOG_AGENT_SOFTWARE_SECRET=
CICD_AGENT_SOFTWARE_ID=
CICD_AGENT_SOFTWARE_SECRET=

# --- Peer ACT client_ids (optional; also written to data/client-ids/ after enroll) ---
# resource= on delegate_subtask is the receiver's client_id, never a URL.
SRE_COORDINATOR_CLIENT_ID=
GITHUB_AGENT_CLIENT_ID=
DATADOG_AGENT_CLIENT_ID=
CICD_AGENT_CLIENT_ID=
