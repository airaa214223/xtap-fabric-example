# Copy to .env and fill in values. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SCENARIO=simple

# --- Cloudsmith (docker build) ---
# PIP_INDEX_URL=https://dl.cloudsmith.io/<TOKEN>/<OWNER>/<REPO>/python/simple/
PIP_INDEX_URL=https://pypi.org/simple
PIP_EXTRA_INDEX_URL=https://pypi.org/simple

# --- Shared ACT (one tenant) ---
XTAP_URL=
XTAP_TENANT_ID=
XTAP_KEY_PASSPHRASE=
# Optional DPoP verify overrides (default: XTAP_URL and {XTAP_URL}/.well-known/jwks.json)
# XTAP_FABRIC_ISSUER=
# XTAP_FABRIC_JWKS_URL=

# --- Per-agent software identities ---
SRE_COORDINATOR_SOFTWARE_ID=
SRE_COORDINATOR_SOFTWARE_SECRET=

GITHUB_AGENT_SOFTWARE_ID=
GITHUB_AGENT_SOFTWARE_SECRET=

DATADOG_AGENT_SOFTWARE_ID=
DATADOG_AGENT_SOFTWARE_SECRET=

CICD_AGENT_SOFTWARE_ID=
CICD_AGENT_SOFTWARE_SECRET=
